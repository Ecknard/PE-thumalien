# ============================================================
# THUMALIEN - Configuration Template
# Copiez ce fichier en .env et remplissez vos vraies valeurs
# NE JAMAIS COMMITTER LE FICHIER .env
# ============================================================

# --- Bluesky API ---
BLUESKY_HANDLE=votre_handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- PostgreSQL ---
DB_NAME=thumalien_db
DB_USER=thumalien_user
DB_PASSWORD=votre_mot_de_passe_securise
DB_HOST=localhost
DB_PORT=5432

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
